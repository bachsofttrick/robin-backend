{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robin-talks",
  "main": "dist/index.js",
  "compatibility_date": "2026-10-10",
  "tsconfig": "./tsconfig.json",
  "placement": {
    "region": "aws:us-west-2"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
